# LoveCards 环境变量配置示例
# 复制此文件为 .env 并填入实际值

APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

# ====================
# 数据库配置
# ====================
[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = lovecards
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false

# ====================
# 邮箱配置
# ====================
[mail]
security = null
driver = smtp
host = smtp.example.com
port = 465
addr = noreply@example.com
pass =
name = LoveCards

# ====================
# 极验验证码配置
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# ====================
[geetest]
STATUS = false
ID =
KEY =

# ====================
# 语言配置
# ====================
[LANG]
default_lang = zh-cn

# ====================
# 系统升级（可选；启用 Release ZIP 升级时配置）
# ====================
# LC_INSTANCE_ROOT = /var/lib/lovecards
# LC_RELEASE_TRUSTED_KEYS_JSON = {"lovecards-release-2026":"/etc/lovecards/release-2026.pub.pem"}
# 可选 worker 管理命令必须是 JSON argv；不配置即为 FPM + MySQL 最小形态
# LC_RUNTIME_DRAIN_COMMAND_JSON = ["/usr/bin/supervisorctl","stop","lovecards-worker:*"]
# LC_RUNTIME_RELOAD_COMMAND_JSON = ["/usr/bin/supervisorctl","restart","lovecards-worker:*"]
# CLI 升级如需同时验证 Web，可指向内置只读探针
# LC_RUNTIME_HEALTH_URL = https://community.example.com/_lc/release-health
# Release ZIP 默认上限为 512 MiB；生产 PHP-FPM/Nginx 必须同步放行 multipart 请求。
# 建议 FPM: post_max_size=768M, upload_max_filesize=512M；Nginx client_max_body_size=768m。
# 本地 dev-backend 脚本会自动注入这些 -d 值，生产环境请在 FPM pool 配置中设置。

# JWT 密钥默认由安装器保存到 LC_INSTANCE_ROOT/shared/keys；以下为显式覆盖
# JWT_PRIVATE_KEY = /run/secrets/lovecards-jwt-private.pem
# JWT_PUBLIC_KEY = /run/secrets/lovecards-jwt-public.pem

# ====================
# Storage 渠道配置（可选，优先级高于数据库）
# 格式：STORAGE_{渠道}_{KEY}
# ====================

# --- COS 腾讯云 ---
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# [COS]
# SECRET_ID =
# SECRET_KEY =
# BUCKET =
# REGION = ap-guangzhou
# CDN_URL =

# --- OSS 阿里云 ---
# [OSS]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# ENDPOINT =
# URL_PREFIX =

# --- 七牛云 ---
# [QINIU]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# DOMAIN =
