# LoveCards 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 调试开关默认关闭：true 会让异常回显完整堆栈（配合 show_error_msg），示例文件照抄即泄露。
# 本地需要调试时再显式改为 true；任何对外环境保持 false。
APP_DEBUG = false

# 安装器会在持久 install.lock 中生成部署 ID；同一站点的 Web、cron、Worker 必须共用。
# 克隆站点可在共享部署配置中显式覆盖，每个克隆必须使用不同值。
# 使用 16—64 位小写字母、数字、下划线或连字符；不要随 Release 更换。
# 示例值不可直接用于部署。
# LC_DEPLOYMENT_ID = replace-with-unique-site-id-0001

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

# ====================
# 数据库配置
# ====================
[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = lovecards
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false

# ====================
# 邮箱配置
# ====================
[mail]
security = null
driver = smtp
host = smtp.example.com
port = 465
addr = noreply@example.com
pass =
name = LoveCards

# ====================
# 极验验证码配置
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# ====================
[geetest]
STATUS = false
ID =
KEY =

# ====================
# 语言配置
# ====================
[LANG]
default_lang = zh-cn

# ====================
# 系统升级（可选；启用 Release ZIP 升级时配置）
# ====================
# LC_INSTANCE_ROOT = /var/lib/lovecards
# LC_RELEASE_TRUSTED_KEYS_JSON = {"lovecards-release-2026":"/etc/lovecards/release-2026.pub.pem"}
# 升级 Contract 的 drain 命令必须是受审 JSON argv。命令须停止并核实 Worker、定时触发与自动重启入口，
# stdout 仅返回 {"workers_stopped":true,"scheduled_trigger_stopped":true,"restart_disabled":true}。
# 如旧 Worker 已退出但数据库残留 running 心跳，命令须在核对 OS 进程身份后封存该行。
# 未配置时 Contract 明确拒绝；普通 FPM + MySQL 安装和非 Contract 运行不依赖此命令。
# LC_RUNTIME_DRAIN_COMMAND_JSON = ["/usr/local/sbin/lc-reviewed-drain"]
# LC_RUNTIME_RELOAD_COMMAND_JSON = ["/usr/bin/supervisorctl","restart","lovecards-worker:*"]
# CLI 升级如需同时验证 Web，可指向内置只读探针
# LC_RUNTIME_HEALTH_URL = https://community.example.com/_lc/release-health
# Release ZIP 默认上限为 512 MiB；生产 PHP-FPM/Nginx 必须同步放行 multipart 请求。
# 建议 FPM: post_max_size=768M, upload_max_filesize=512M；Nginx client_max_body_size=768m。
# 本地 dev-backend 脚本会自动注入这些 -d 值，生产环境请在 FPM pool 配置中设置。

# JWT 密钥默认由安装器保存到 LC_INSTANCE_ROOT/shared/keys；以下为显式覆盖
# JWT_PRIVATE_KEY = /run/secrets/lovecards-jwt-private.pem
# JWT_PUBLIC_KEY = /run/secrets/lovecards-jwt-public.pem

# ====================
# Storage 渠道配置（可选，优先级高于数据库）
# 格式：STORAGE_{渠道}_{KEY}
# ====================

# --- COS 腾讯云 ---
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# [COS]
# SECRET_ID =
# SECRET_KEY =
# BUCKET =
# REGION = ap-guangzhou
# CDN_URL =

# --- OSS 阿里云 ---
# [OSS]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# ENDPOINT =
# URL_PREFIX =

# --- 七牛云 ---
# [QINIU]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# DOMAIN =
