{
  "name": "@lovecards/sdk",
  "version": "2.0.0",
  "description": "LoveCards3 JavaScript SDK",
  "type": "module",
  "main": "dist/lovecards.cjs",
  "module": "dist/lovecards.es.js",
  "types": "dist/lovecards.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lovecards.es.js",
      "require": "./dist/lovecards.cjs",
      "default": "./dist/lovecards.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "1.16.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vite-plugin-dts": "4.5.4"
  }
}
